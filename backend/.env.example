# EmiSaver Backend Configuration

# Neon Serverless PostgreSQL Connection String
# Example: postgresql+asyncpg://user:password@ep-cool-name-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./emisaver.db

# Processing Confidence Threshold (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.60

# Default Lookback Months for SMS scan
DEFAULT_LOOKBACK_MONTHS=6

# API Secret
API_SECRET=your-secret-key-for-jwt-and-signing
